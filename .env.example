# Chave da API do Google Gemini (obrigatória para análise de referência,
# geração de estampas e o assistente técnico). Obtenha em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# URL pública da aplicação (usada em metadados e links absolutos). Opcional.
APP_URL=http://localhost:3000

# Modelos Gemini (opcionais — valores padrão sensatos são usados se ausentes).
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
