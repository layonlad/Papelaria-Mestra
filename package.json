{
  "name": "papelaria-mestra",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Plataforma web full-stack para criação, personalização e exportação de moldes estruturais (dielines) de papelaria artesanal, com IA Gemini.",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --target=node18 --packages=external --outfile=dist/server.cjs",
    "start": "cross-env NODE_ENV=production node dist/server.cjs"
  },
  "dependencies": {
    "@google/genai": "^0.14.0",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "motion": "^11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "esbuild": "^0.24.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
